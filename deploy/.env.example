# EC2 의 배포 디렉터리에 .env 로 복사해 값을 채운다. 저장소에 커밋하지 않는다.

APP_IMAGE=ghcr.io/yoohyebin/dalbit-tarot:latest

MYSQL_ROOT_PASSWORD=바꿀것
DB_USERNAME=dalbit
DB_PASSWORD=바꿀것

# 무료 티어는 입력이 모델 학습에 쓰인다. 운영에서는 유료 키를 쓴다
GEMINI_API_KEY=

# 관리자 화면(/admin) 로그인. 피드백을 여기서 본다.
# 비워 두면 컨테이너가 뜰 때마다 무작위 비밀번호를 만들어 로그에만 남긴다.
# 재시작할 때마다 값이 바뀌므로 운영에서는 반드시 채운다.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 카카오톡 공유. Kakao Developers 앱의 JavaScript 키.
# 비워 두면 공유 버튼이 기존 방식(공유 시트 → 링크 복사)으로 동작한다
KAKAO_JAVASCRIPT_KEY=
